<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="STageAPP_1.ConfiguracionPortentaPage"
    Title="Configuration Portenta"
    BackgroundColor="{StaticResource ColorFondoPrincipal}">

    <ScrollView>

        <StackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Configuration Portenta"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="{StaticResource ColorTextoPrincipal}"
                HorizontalTextAlignment="Center"
                Margin="0,10,0,5"/>

            <Label
                Text="Paramètres d'acquisition de l'équipement"
                FontSize="15"
                TextColor="{StaticResource ColorTextoSecundario}"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,10"/>

            <!-- Velocidad de recolección de datos -->

            <Frame
                BackgroundColor="{StaticResource ColorTarjeta}"
                BorderColor="{StaticResource ColorBordeTarjeta}"
                CornerRadius="12"
                HasShadow="False"
                Padding="18">

                <StackLayout Spacing="10">

                    <Label
                        Text="Vitesse de collecte des données"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{StaticResource ColorTextoPrincipal}"/>

                    <Label
                        Text="Intervalle entre les échantillons pris par le Portenta."
                        FontSize="13"
                        TextColor="{StaticResource ColorTextoSecundario}"/>

                    <Picker
                        x:Name="SelectorVelocidad"
                        Title="Sélectionner la vitesse"
                        FontSize="16"
                        Margin="0,5,0,0"
                        TextColor="{StaticResource ColorTextoPrincipal}"
                        TitleColor="{StaticResource ColorTextoSecundario}"
                        BackgroundColor="{StaticResource ColorFondoPrincipal}"
                        HorizontalOptions="FillAndExpand"
                        SelectedIndexChanged="OnVelocidadSeleccionada"/>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{StaticResource ColorDivisor}"
                        Margin="0,8,0,4"/>

                    <Label
                        x:Name="LabelEstadoEnvio"
                        Text="Sélectionnez une vitesse pour l'envoyer au Portenta."
                        FontSize="13"
                        TextColor="{StaticResource ColorTextoSecundario}"
                        LineBreakMode="WordWrap"/>

                </StackLayout>

            </Frame>

            <!-- Salida por puerto serie -->

            <Frame
                BackgroundColor="{StaticResource ColorTarjeta}"
                BorderColor="{StaticResource ColorBordeTarjeta}"
                CornerRadius="12"
                HasShadow="False"
                Padding="18">

                <StackLayout Spacing="10">

                    <Grid ColumnSpacing="14">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackLayout
                            Grid.Column="0"
                            Spacing="4"
                            VerticalOptions="Center">

                            <Label
                                Text="Sortie par port série"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource ColorTextoPrincipal}"/>

                            <Label
                                Text="Émission des paquets par USB. Désactivez-la pour alléger le cycle sur des périodes courtes."
                                FontSize="13"
                                TextColor="{StaticResource ColorTextoSecundario}"/>

                        </StackLayout>

                        <!--
                            Interruptor. Se construye a mano en lugar de
                            usar el Switch nativo para que respete la
                            paleta y se vea igual en Android y en iOS.
                        -->

                        <Grid
                            x:Name="ContenedorInterruptor"
                            Grid.Column="1"
                            WidthRequest="58"
                            HeightRequest="32"
                            HorizontalOptions="End"
                            VerticalOptions="Center">

                            <Frame
                                x:Name="PistaInterruptor"
                                CornerRadius="16"
                                Padding="0"
                                HasShadow="False"
                                BorderColor="Transparent"
                                BackgroundColor="{StaticResource ColorAcento}"/>

                            <BoxView
                                x:Name="PulgarInterruptor"
                                WidthRequest="24"
                                HeightRequest="24"
                                CornerRadius="12"
                                Color="{StaticResource ColorTextoPrincipal}"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                Margin="4,0,0,0"/>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnInterruptorSerialPulsado"/>
                            </Grid.GestureRecognizers>

                        </Grid>

                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{StaticResource ColorDivisor}"
                        Margin="0,8,0,4"/>

                    <Label
                        x:Name="LabelEstadoSerial"
                        Text="Activée. Le Portenta démarre toujours en émettant sur le port série."
                        FontSize="13"
                        TextColor="{StaticResource ColorTextoSecundario}"
                        LineBreakMode="WordWrap"/>

                </StackLayout>

            </Frame>

            <!-- Reloj del Portenta -->

            <Frame
                BackgroundColor="{StaticResource ColorTarjeta}"
                BorderColor="{StaticResource ColorBordeTarjeta}"
                CornerRadius="12"
                HasShadow="False"
                Padding="18">

                <StackLayout Spacing="10">

                    <Label
                        Text="Horloge du Portenta"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{StaticResource ColorTextoPrincipal}"/>

                    <Label
                        Text="Le module DS3231 n'a aucun accès au réseau. C'est l'application qui lui transmet l'heure du téléphone, envoyée automatiquement à l'ouverture de cette page."
                        FontSize="13"
                        TextColor="{StaticResource ColorTextoSecundario}"/>

                    <Label
                        x:Name="LabelHoraTelefono"
                        Text="Heure du téléphone : --"
                        FontSize="15"
                        TextColor="{StaticResource ColorTextoPrincipal}"
                        Margin="0,4,0,0"/>

                    <Button
                        x:Name="BotonSincronizarHora"
                        Text="Mettre le Portenta à l'heure"
                        FontSize="16"
                        HeightRequest="52"
                        CornerRadius="10"
                        Margin="0,4,0,0"
                        BackgroundColor="{StaticResource ColorAcentoBoton}"
                        TextColor="{StaticResource ColorAcentoTexto}"
                        Clicked="OnSincronizarHoraPulsado"/>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{StaticResource ColorDivisor}"
                        Margin="0,8,0,4"/>

                    <Label
                        x:Name="LabelEstadoHora"
                        Text="L'heure est envoyée automatiquement à l'ouverture de cette page."
                        FontSize="13"
                        TextColor="{StaticResource ColorTextoSecundario}"
                        LineBreakMode="WordWrap"/>

                </StackLayout>

            </Frame>

        </StackLayout>

    </ScrollView>

</ContentPage>
