<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="STageAPP_1.MainPage"
    Title="Menu principal"
    BackgroundColor="{StaticResource ColorFondoPrincipal}">
    <ScrollView>
        <StackLayout
            Padding="30"
            Spacing="25"
            VerticalOptions="Center">
            <Label
                Text="Système d'acquisition"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="{StaticResource ColorTextoPrincipal}"
                HorizontalTextAlignment="Center"/>
            <Label
                Text="Sélectionnez une option"
                FontSize="18"
                TextColor="{StaticResource ColorTextoSecundario}"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,10"/>
            <!-- Estado de la conexión BLE -->
            <Frame
                BackgroundColor="{StaticResource ColorTarjeta}"
                BorderColor="{StaticResource ColorBordeTarjeta}"
                CornerRadius="12"
                HasShadow="False"
                Padding="14"
                Margin="0,5,0,15">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Punto de estado -->
                    <Frame
                        x:Name="IndicadorBluetooth"
                        Grid.Column="0"
                        WidthRequest="16"
                        HeightRequest="16"
                        CornerRadius="8"
                        Padding="0"
                        HasShadow="False"
                        BackgroundColor="{StaticResource ColorIndicadorInactivo}"
                        VerticalOptions="Start"
                        Margin="0,5,0,0"/>
                    <StackLayout
                        Grid.Column="1"
                        Spacing="3">
                        <Label
                            x:Name="LabelEstadoBluetooth"
                            Text="Bluetooth déconnecté"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{StaticResource ColorTextoPrincipal}"/>
                        <Label
                            x:Name="LabelNombreDispositivo"
                            Text="Aucun appareil connecté"
                            FontSize="13"
                            TextColor="{StaticResource ColorTextoSecundario}"/>
                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{StaticResource ColorDivisor}"
                            Margin="0,9,0,6"/>
                        <Label
                            Text="Dernière donnée reçue"
                            FontSize="12"
                            TextColor="{StaticResource ColorTextoSecundario}"/>
                        <Label
                            x:Name="LabelUltimoDatoBluetooth"
                            Text="En attente d'informations..."
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{StaticResource ColorTextoPrincipal}"
                            LineBreakMode="WordWrap"/>
                    </StackLayout>
                </Grid>
            </Frame>
            <Button
                Text="Configurer les capteurs"
                FontSize="18"
                HeightRequest="60"
                CornerRadius="10"
                BackgroundColor="{StaticResource ColorAcentoBoton}"
                TextColor="{StaticResource ColorAcentoTexto}"
                Clicked="OnConfigurarSensoresClicked"/>
            <Button
                Text="Configuration Portenta"
                FontSize="18"
                HeightRequest="60"
                CornerRadius="10"
                BackgroundColor="{StaticResource ColorAcentoBoton}"
                TextColor="{StaticResource ColorAcentoTexto}"
                Clicked="OnConfiguracionPortentaClicked"/>
            <Button
                Text="Visualiser les données"
                FontSize="18"
                HeightRequest="60"
                CornerRadius="10"
                BackgroundColor="{StaticResource ColorAcentoBoton}"
                TextColor="{StaticResource ColorAcentoTexto}"
                Clicked="OnVisualizarDatosClicked"/>
        </StackLayout>
    </ScrollView>
</ContentPage>
